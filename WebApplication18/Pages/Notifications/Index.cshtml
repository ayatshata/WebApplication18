@page
@model MughtaribatHouse.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = "الإشعارات";
    ViewData["ActivePage"] = "Notifications";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">الإشعارات</h1>
    <div>
        <button id="markAllRead" class="btn btn-success btn-sm">
            <i class="fas fa-check-double"></i> الكل كمقروء
        </button>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">الإشعارات</h6>
            </div>
            <div class="card-body">
                <div class="list-group">
                    @foreach (var notification in Model.Notifications)
                    {
                        <div class="list-group-item list-group-item-action flex-column align-items-start
                                        @(notification.IsRead ? "" : "list-group-item-new")">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1">
                                    @if (!notification.IsRead)
                                    {
                                        <span class="badge badge-primary">جديد</span>
                                    }
                                    @notification.Title
                                </h5>
                                <small class="text-muted">@notification.CreatedAt.ToString("yyyy/MM/dd HH:mm")</small>
                            </div>
                            <p class="mb-1">@notification.Message</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">@notification.Type</small>
                                <div>
                                    @if (!notification.IsRead)
                                    {
                                        <button class="btn btn-sm btn-outline-success mark-read" data-id="@notification.Id">
                                            <i class="fas fa-check"></i> كمقروء
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger delete-notification" data-id="@notification.Id">
                                        <i class="fas fa-trash"></i> حذف
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (!Model.Notifications.Any())
                {
                    <div class="text-center py-4">
                        <i class="fas fa-bell fa-3x text-gray-300 mb-3"></i>
                        <p class="text-muted">لا توجد إشعارات</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


<style>

    .list-group-item-new {
        background-color: #ffe6f0; 
        border-left: 5px solid #ff66b2;
    }

 
    .flower {
        position: fixed;
        width: 25px;
        height: 25px;
        pointer-events: none;
    
        background-size: cover;
        opacity: 0.8;
        animation: fall linear forwards;
        background-image: url('/images/flower.png');
    
</style>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        // تمييز كمقروء
        document.querySelectorAll(".mark-read").forEach(button => {
            button.addEventListener("click", async () => {
                const id = button.dataset.id;
                await fetch(`/api/notifications/markread/${id}`, { method: "POST" });
                button.closest(".list-group-item").classList.remove("list-group-item-new");
                button.remove();
                createFlower();
            });
        });

  
        const markAll = document.getElementById("markAllRead");
        markAll?.addEventListener("click", async () => {
            await fetch(`/api/notifications/markallread`, { method: "POST" });
            document.querySelectorAll(".list-group-item-new").forEach(el => el.classList.remove("list-group-item-new"));
            for(let i=0;i<10;i++){ createFlower(); }
        });

    
        function createFlower() {
            const flower = document.createElement("div");
            flower.classList.add("flower");
            flower.style.left = Math.random() * window.innerWidth + "px";
            flower.style.animationDuration = (3 + Math.random() * 2) + "s";
            document.body.appendChild(flower);
            setTimeout(() => flower.remove(), 5000);
        }
    });
</script>
