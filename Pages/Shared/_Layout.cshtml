@{
    ViewData["Title"] = ViewData["Title"] ?? "لوحة التحكم";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - دار المغتربات</title>

    <!-- ✅ Bootstrap RTL -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />

    <!-- ✅ Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet" />

    <!-- ✅ Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        body {
            background-color: #f9fafc;
            font-family: 'Tajawal', sans-serif;
        }

        /* ===== Sidebar ===== */
        .sidebar {
            background-color: #b03060; /* بينك غامق */
            min-height: 100vh;
            padding-top: 1rem;
        }

            .sidebar .nav-link {
                color: #fff;
                transition: 0.3s;
                font-size: 0.95rem;
            }

                .sidebar .nav-link:hover,
                .sidebar .nav-link.active {
                    background-color: rgba(255, 255, 255, 0.15);
                    border-radius: 10px;
                }

        .sidebar-brand-text {
            font-weight: bold;
            font-size: 1.1rem;
        }

        /* ===== Topbar ===== */
        .topbar {
            background-color: #fff;
            border-bottom: 1px solid #eee;
        }

        footer {
            background-color: #fff;
            padding: 1rem 0;
            border-top: 1px solid #eee;
            color: #777;
        }
    </style>
</head>

<body id="page-top">
    <div id="wrapper" class="d-flex">

        <!-- ✅ Sidebar -->
        <ul class="navbar-nav sidebar sidebar-dark accordion p-3" id="accordionSidebar">
            <a class="sidebar-brand d-flex align-items-center justify-content-center mb-3 text-white text-decoration-none" href="/">
                <div class="sidebar-brand-icon rotate-n-15 me-2">
                    <i class="fas fa-home"></i>
                </div>
                <div class="sidebar-brand-text">دار المغتربات</div>
            </a>
            <hr class="sidebar-divider bg-light" />

            <li class="nav-item">
                <a class="nav-link" href="/Dashboard"><i class="fas fa-fw fa-tachometer-alt me-2"></i> لوحة التحكم</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/Residents"><i class="fas fa-fw fa-users me-2"></i> المقيمات</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/Payments"><i class="fas fa-fw fa-dollar-sign me-2"></i> المدفوعات</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/Maintenance"><i class="fas fa-fw fa-tools me-2"></i> الصيانة</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/Reports"><i class="fas fa-fw fa-chart-bar me-2"></i> التقارير</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/Notifications"><i class="fas fa-fw fa-bell me-2"></i> الإشعارات</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/Reviews"><i class="fas fa-fw fa-star me-2"></i> التقييمات</a>
            </li>
        </ul>

        <!-- ✅ Main Content -->
        <div id="content-wrapper" class="d-flex flex-column flex-grow-1">
            <div id="content">

                <!-- ✅ Topbar -->
                <nav class="navbar navbar-expand navbar-light topbar shadow-sm">
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle me-3">
                        <i class="fa fa-bars"></i>
                    </button>

                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item mx-2">
                            <a class="nav-link" href="#">
                                <i class="fas fa-bell fa-fw"></i>
                                <span class="badge bg-danger" id="notificationCount">0</span>
                            </a>
                        </li>
                        <li class="nav-item mx-2">
                            <a class="nav-link" href="#" id="clearNotificationsBtn">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </li>
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" data-bs-toggle="dropdown">
                                <span class="me-2 text-gray-600 small">آيات علي</span>
                                <img class="rounded-circle animate__animated animate__pulse animate__infinite"
                                     src="~/images/Cute icon 🌷 صوره كيوته  للبروفايل 🌸.jpeg"
                                     alt="girl icon" width="45" height="45" />
                            </a>
                        </li>
                    </ul>
                </nav>

                <!-- ✅ Main Page Content -->
                <div class="container-fluid py-4">
                    @RenderBody()
                </div>
            </div>

            <!-- ✅ Footer -->
            <footer class="sticky-footer text-center mt-auto">
                <div class="container my-auto">
                    <span>© دار المغتربات - آيات علي @DateTime.Now.Year</span>
                </div>
            </footer>
        </div>
    </div>

    <!-- ✅ Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
